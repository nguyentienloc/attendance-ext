{
  "manifest_version": 3,
  "name": "Attendance Fixer",
  "version": "1.0.1",
  "description": "",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:9001/*",
    "https://erp.salely.ai/*",
    "https://apicc.neoo.io.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://erp.salely.ai/odoo/attendances/*",
        "https://erp.salely.ai/odoo/attendances"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
